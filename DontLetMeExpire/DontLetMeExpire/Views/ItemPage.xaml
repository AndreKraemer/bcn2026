<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DontLetMeExpire.Views.ItemPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ai="clr-namespace:DontLetMeExpire.AI"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:strings="clr-namespace:DontLetMeExpire.Resources.Strings"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewModels="clr-namespace:DontLetMeExpire.ViewModels"
    Title="{Binding Title}"
    x:DataType="viewModels:ItemViewModel"
    HideSoftInputOnTapped="True">
    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:IsStringNullOrEmptyConverter x:Key="IsStringNullOrEmptyConverter" />
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="IsStringNotNullOrEmptyConverter" />
            <toolkit:IsListNotNullOrEmptyConverter x:Key="IsListNotNullOrEmptyConverter" />
            <toolkit:ListToStringConverter x:Key="ListToStringConverter" Separator="," />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <Grid RowDefinitions="300, auto">
            <!--  Produktbild anzeigen  -->
            <Image
                Aspect="AspectFill"
                BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLightLight},
                                                  Dark={StaticResource PrimaryDarkDark}}"
                HeightRequest="300"
                Source="{Binding Image}" />
            <Button
                Margin="{StaticResource ThicknessM}"
                Command="{Binding DeletePhotoCommand}"
                HorizontalOptions="End"
                IsVisible="{Binding Image, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                Text="{x:Static strings:AppResources.DeleteImage}"
                VerticalOptions="Start" />
            <FlexLayout
                AlignItems="Center"
                Direction="Column"
                IsVisible="{Binding Image, Converter={StaticResource IsStringNullOrEmptyConverter}}"
                JustifyContent="Center">
                <Label
                    FontFamily="MaterialSymbolsRounded"
                    FontSize="{StaticResource SizeXXL}"
                    Text="{StaticResource IconAdd_a_photo}"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryLightDark},
                                                Dark={StaticResource PrimaryDarkLightest}}" >
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding TakePhotoCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="{x:Static strings:AppResources.TapToAddImage}" />
            </FlexLayout>

            <!--  Eingabefelder für das Produkt  -->
            <VerticalStackLayout
                Grid.Row="1"
                Padding="{StaticResource ThicknessM}"
                Spacing="{StaticResource SizeXS}">
                <Border
                    BackgroundColor="{StaticResource ErrorLightest}"
                    IsVisible="{Binding HasErrors}"
                    Stroke="{StaticResource ErrorDark}"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="0">
                    <Grid
                        ColumnDefinitions="4, auto, *"
                        ColumnSpacing="{StaticResource SizeXS}"
                        RowDefinitions="auto, auto, auto"
                        RowSpacing="{StaticResource SizeXS}">
                        <BoxView
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Grid.Column="0"
                            BackgroundColor="{StaticResource ErrorDark}" />
                        <Label
                            Grid.Column="1"
                            FontFamily="MaterialSymbolsRounded"
                            FontSize="{StaticResource SizeL}"
                            StyleClass="mt-xxs"
                            Text="{StaticResource IconError}"
                            TextColor="{StaticResource ErrorDark}"
                            VerticalOptions="End" />
                        <Label
                            Grid.Row="0"
                            Grid.Column="2"
                            FontSize="{StaticResource SizeM}"
                            StyleClass="mt-xs, bold"
                            Text="{x:Static strings:AppResources.ErrorsHeader}"
                            TextColor="{StaticResource PrimaryDarkDarkest}" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="2"
                            Text="{x:Static strings:AppResources.ErrorsSubHeader}"
                            TextColor="{StaticResource PrimaryDarkDark}" />
                        <VerticalStackLayout
                            Grid.Row="2"
                            Grid.Column="2"
                            Margin="{StaticResource ThicknessXS}"
                            BindableLayout.ItemsSource="{Binding ErrorMessages}"
                            Spacing="{StaticResource SizeXXS}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <HorizontalStackLayout>
                                        <Label
                                            StyleClass="mr-xs"
                                            Text="&#x2022;"
                                            TextColor="{StaticResource PrimaryDarkDark}" />
                                        <Label
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding}"
                                            TextColor="{StaticResource PrimaryDarkDark}" />
                                    </HorizontalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                <!--  Gespeichertes Lebensmittel: KI fragen ("Kann ich das noch essen?")  -->
                <Border
                    Padding="14,10"
                    IsVisible="{Binding HasId}"
                    StrokeShape="RoundRectangle 22"
                    StrokeThickness="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#6A5AE0" />
                            <GradientStop Offset="1" Color="{StaticResource Primary}" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#6A5AE0" Opacity="0.3" Radius="8" Offset="0,4" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AskAiCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="{StaticResource SizeXS}">
                        <Label
                            FontFamily="MaterialSymbolsRounded"
                            FontSize="22"
                            Text="{StaticResource IconAI}"
                            TextColor="White"
                            VerticalOptions="Center" />
                        <Label
                            FontAttributes="Bold"
                            Text="{x:Static strings:AppResources.AskAi}"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!--  Erfassung per Foto und KI  -->
                <Grid ColumnDefinitions="*, auto, auto" ColumnSpacing="{StaticResource SizeXS}">
                    <Button Command="{Binding CaptureWithAiCommand}" Text="{x:Static strings:AppResources.CaptureWithAi}" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding PickPhotoWithAiCommand}"
                        Text="{x:Static strings:AppResources.PickPhotoWithAi}" />
                    <!--  Per Sprache korrigieren oder ohne Foto erfassen  -->
                    <Button
                        Grid.Column="2"
                        Command="{Binding SpeakCorrectionCommand}"
                        FontFamily="MaterialSymbolsRounded"
                        FontSize="{StaticResource SizeL}"
                        SemanticProperties.Description="{x:Static strings:AppResources.SpeakCorrection}"
                        Text="{StaticResource IconMic}"
                        ToolTipProperties.Text="{x:Static strings:AppResources.SpeakCorrection}">
                        <Button.Triggers>
                            <DataTrigger
                                Binding="{Binding IsListening}"
                                TargetType="Button"
                                Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource ErrorDark}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
                <Label
                    FontAttributes="Italic"
                    IsVisible="{Binding VoiceText, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                    Text="{Binding VoiceText}" />
                <HorizontalStackLayout IsVisible="{Binding RecognitionHint, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" Spacing="{StaticResource SizeXS}">
                    <ActivityIndicator
                        HeightRequest="20"
                        IsRunning="{Binding IsRecognizing}"
                        IsVisible="{Binding IsRecognizing}"
                        WidthRequest="20" />
                    <Label Text="{Binding RecognitionHint}" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!--  Live-Protokoll der Tool-Aufrufe (in den Einstellungen abschaltbar)  -->
                <Border
                    Padding="{StaticResource ThicknessXS}"
                    IsVisible="{Binding ShowToolCalls}"
                    Stroke="{AppThemeBinding Light={StaticResource PrimaryLightDark},
                                             Dark={StaticResource PrimaryDarkLightest}}"
                    StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="{StaticResource SizeXXS}">
                        <Label StyleClass="bold" Text="{x:Static strings:AppResources.ToolCalls}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ToolCalls}" Spacing="{StaticResource SizeXXS}">
                            <BindableLayout.EmptyView>
                                <Label FontSize="12" Text="–" />
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="ai:ToolCallEntry">
                                    <VerticalStackLayout>
                                        <Label FontFamily="Consolas" FontSize="13">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Status}" />
                                                    <Span Text=" 🔧 " />
                                                    <Span FontAttributes="Bold" Text="{Binding Name}" />
                                                    <Span Text="(" />
                                                    <Span Text="{Binding Arguments}" />
                                                    <Span Text=")  " />
                                                    <Span Text="{Binding Duration}" TextColor="Gray" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label
                                            Margin="24,0,0,0"
                                            FontSize="12"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="3"
                                            Text="{Binding Result, StringFormat='→ {0}'}"
                                            TextColor="Gray" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*, auto" ColumnSpacing="{StaticResource SizeXS}">
                    <SearchBar
                        ios:SearchBar.SearchBarStyle="Minimal"
                        Placeholder="{x:Static strings:AppResources.SearchBarcode}"
                        SearchCommand="{Binding SearchBarcodeCommand}"
                        Text="{Binding SearchText}"
                        SearchIconColor="{DynamicResource Primary}"/>
                    <Button
                        Grid.Column="1"
                        Command="{Binding ScanBarcodeCommand}"
                        FontFamily="MaterialSymbolsRounded"
                        FontSize="{StaticResource SizeL}"
                        Text="{StaticResource IconBarcode_scanner}" />
                </Grid>
                <!--  Platzhalter für den Barcode-Scanner. Die Kameraansicht wird erst  -->
                <!--  im Code-Behind erzeugt, wenn der Scan-Button gedrückt wird.       -->
                <ContentView
                    x:Name="ScannerHost"
                    HeightRequest="300"
                    WidthRequest="300"
                    IsVisible="{Binding ShowBarcodeScanner}" />
                <Label Text="{x:Static strings:AppResources.Name}" />
                <Label
                    IsVisible="{Binding PropertyErrorMessages[Name], Converter={StaticResource IsListNotNullOrEmptyConverter}, FallbackValue=False}"
                    StyleClass="ErrorLabel"
                    Text="{Binding PropertyErrorMessages[Name], Converter={StaticResource ListToStringConverter}}" />
                <Entry Text="{Binding Name}"/>
                <Label StyleClass="mt-xs" Text="{x:Static strings:AppResources.StorageLocation}" />
                <Picker
                    ItemDisplayBinding="{Binding Name}"
                    ItemsSource="{Binding StorageLocations}"
                    SelectedItem="{Binding SelectedLocation}" />
                <Label StyleClass="mt-xs" Text="{x:Static strings:AppResources.ExpirationDate}" />
                <Grid ColumnDefinitions="*, auto" ColumnSpacing="{StaticResource SizeXS}">
                    <DatePicker Date="{Binding ExpirationDate}" />
                    <!--  KI setzt das Datum auf die Haltbarkeit nach dem Öffnen  -->
                    <Button
                        Grid.Column="1"
                        Command="{Binding OpenedCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Text="{x:Static strings:AppResources.Opened}" />
                </Grid>
                <Label StyleClass="mt-xs" Text="{x:Static strings:AppResources.DateTypeLabel}" />
                <Picker
                    ItemDisplayBinding="{Binding Value}"
                    ItemsSource="{Binding DateKinds}"
                    SelectedItem="{Binding SelectedDateKind}" />
                <Label StyleClass="mt-xs" Text="{x:Static strings:AppResources.Amount}" />
                <Label
                    IsVisible="{Binding PropertyErrorMessages[Amount], Converter={StaticResource IsListNotNullOrEmptyConverter}, FallbackValue=False}"
                    StyleClass="ErrorLabel"
                    Text="{Binding PropertyErrorMessages[Amount], Converter={StaticResource ListToStringConverter}}" />
                <Entry Keyboard="Numeric" Text="{Binding Amount}" />
                <Button
                    Command="{Binding SaveCommand}"
                    StyleClass="mt-xs"
                    Text="{x:Static strings:AppResources.Save}" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>