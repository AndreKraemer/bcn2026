<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="MauiAppMaterial3Demo.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Label Text="Button" FontAttributes="Bold"/>
            <Button
                x:Name="CounterBtn"
                Text="Click me"
                SemanticProperties.Hint="Counts the number of times you click"
                Clicked="OnCounterClicked"
                HorizontalOptions="Fill" />
            <Label Text="Entry" FontAttributes="Bold"/>
            <Entry Placeholder="Entry 1"/>
            <Label Text="Slider" FontAttributes="Bold"/>
            <Slider Minimum="0" Maximum="100" Value="50"/>
            <Label Text="Switch" FontAttributes="Bold"/>
            <Switch IsToggled="True"/>
            <Label Text="Datepicker" FontAttributes="Bold"/>
            <DatePicker/>
            <Label Text="Timepicker" FontAttributes="Bold"/>
            <TimePicker/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
